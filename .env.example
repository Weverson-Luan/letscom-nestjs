# ================================
# APLICAÇÃO
# ================================
APP_NAME="Api Crachas"
APP_ENV=development
APP_PORT=3000
# Prefixo global de rota (compatibilidade com o Laravel: env APP_CONTEXT)
APP_CONTEXT=apiparcelas
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

# ================================
# BANCO DE DADOS (MySQL/MariaDB)
# ================================
# Prisma usa uma única string de conexão
DATABASE_URL="mysql://root:letscom2026%40@127.0.0.1:3306/letscom"

# ================================
# JWT
# ================================
JWT_SECRET=
# TTL do access token JWT em dias (default 7)
JWT_ACCESS_TTL_DAYS=7
# TTL do refresh token persistido em dias (default 30)
JWT_REFRESH_TTL=30
JWT_ALGORITHM=HS256

# ================================
# SEGURANÇA
# ================================
BCRYPT_ROUNDS=12

# ================================
# REDIS (cache)
# ================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# TTL (segundos) dos caches de listagem de remessas
REMESSAS_CACHE_TTL=60

# ================================
# STORAGE (Cloudflare R2 / S3-compatível)
# ================================
# disco padrão: local | r2
FILESYSTEM_DISK=local
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
# expiração (segundos) das URLs assinadas
SIGNED_URL_EXPIRATION=900

# ================================
# E-MAIL (MailerSend)
# ================================
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAILERSEND_API_KEY=
MAILERSEND_TIMEOUT=30

# ================================
# REGRAS DE NEGÓCIO
# ================================
SENHA_USUARIO_SUBORDINADO_LETSCOM_DEFAULT=
USER_ID_EXECUTOR_ADMIN=

# ================================
# LOGS
# ================================
LOG_LEVEL=debug

# ================================
# UPLOAD
# ================================
# tamanho máximo de upload em bytes (200MB)
MAX_UPLOAD_SIZE=209715200
