# ================================
# APLICAÇÃO
# ================================
APP_NAME="Api Crachas"
NODE_ENV=development
#NODE_ENV=production
APP_PORT=8000
APP_CONTEXT=apiparcelas
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo

# ================================
# Acesso ao frontend
# ================================
FRONTEND_URL=http://localhost:8000

# ================================
# BANCO DE DADOS (MySQL)
# ================================
# fora do Docker: mysql://usuario:senha@localhost:3306/banco
# no Docker o DATABASE_URL é montado a partir das MYSQL_* abaixo
# (senha com caracteres especiais precisa estar URL-encoded)
DATABASE_URL=
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# porta do MySQL exposta no host (apenas docker-compose.dev.yml)
MYSQL_PORT=3306

# ================================
# JWT
# ================================
JWT_SECRET=

# ================================
# TTL do access token JWT em dias (default 7)
# ================================
JWT_ACCESS_TTL_DAYS=

# ================================
# TTL do refresh token persistido em dias (default 30)
# ================================
JWT_REFRESH_TTL=
JWT_ALGORITHM=

# ================================
# SEGURANÇA
# ================================
BCRYPT_ROUNDS=

# ================================
# REDIS (cache)
# ================================
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
# TTL (segundos) dos caches de listagem de remessas
REMESSAS_CACHE_TTL=6

# ================================
# STORAGE (Cloudflare R2 / S3-compatível)
# ================================
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=letscom-media
CLOUDFLARE_R2_ENDPOINT=

# disco padrão: local | r2
FILESYSTEM_DISK=local

# expiração (segundos) das URLs assinadas
SIGNED_URL_EXPIRATION=

# ================================
# E-MAIL (MailerSend)
# ================================
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAILERSEND_API_KEY=
MAILERSEND_TIMEOUT=
# atraso (ms) entre e-mails enviados em lote (rate limiting do MailerSend)
EMAIL_SEND_DELAY=500

# ================================
# REGRAS DE NEGÓCIO
# ================================
SENHA_USUARIO_SUBORDINADO_LETSCOM_DEFAULT=
USER_ID_EXECUTOR_ADMIN=

# ================================
# LOGS
# ================================
LOG_LEVEL=debug

# ================================
# UPLOAD tamanho máximo de upload em bytes (200MB)
# ================================
MAX_UPLOAD_SIZE=
