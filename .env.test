# AMBIENTE DE TESTES E2E - NUNCA PRODUÇÃO
# Aponta para os containers do docker-compose.test.yml (npm run docker:test).
# Credenciais fixas de teste, sem segredo: o arquivo é versionado.

# banco isolado (letscom-bd-test). Precisa terminar em _test: o limparBanco recusa outro nome.
DATABASE_URL="mysql://letscom:letscom@127.0.0.1:3308/letscom_test"

# cache isolado (letscom-redis-test)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

NODE_ENV=test
